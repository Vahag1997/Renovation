# Скопируй эти переменные в Vercel:
#   Project → Settings → Environment Variables (Production + Preview)
# Значения возьми из своего локального файла .env.local
# ВАЖНО: после добавления переменных нужно сделать Redeploy —
# NEXT_PUBLIC_* подставляются во время сборки.

# --- Публичные ключи (нужны, чтобы сайт читал контент из базы) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Public production URL (canonical links, robots.txt and sitemap.xml) ---
NEXT_PUBLIC_SITE_URL=https://www.aeremont.ru

# --- Секретный ключ (нужен для админки: запись и загрузка фото) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Required admin authentication ---
ADMIN_PASSWORD=
# Generate a long random value, for example: openssl rand -hex 32
ADMIN_SESSION_SECRET=
